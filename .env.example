# Configuracao opcional para persistencia externa (Supabase)
SUPABASE_URL=https://SEU-PROJETO.supabase.co
SUPABASE_SERVICE_ROLE_KEY=COLE_AQUI_A_SERVICE_ROLE_KEY
SUPABASE_TABLE=participants_store

# Persistencia principal recomendada (PostgreSQL)
DATABASE_URL=postgresql://usuario:senha@host:5432/database
POSTGRES_TABLE=participants_store
