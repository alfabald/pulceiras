# Configuracao opcional para persistencia externa (Supabase)
SUPABASE_URL=https://SEU-PROJETO.supabase.co
SUPABASE_SERVICE_ROLE_KEY=COLE_AQUI_A_SERVICE_ROLE_KEY
SUPABASE_TABLE=participants_store

# Persistencia principal recomendada (PostgreSQL)
DATABASE_URL=postgresql://usuario:senha@host:5432/database
POSTGRES_TABLE=participants_store

# Perfis opcionais (senhas em texto simples, definir no servidor)
ENTRY_PIN=senha-da-equipe-de-entrada
FINANCE_PIN=senha-da-equipe-financeira
VIEWER_PIN=senha-somente-leitura

# Segurança administrativa opcional: limitar logins/ações admin a IPs específicos.
# Formato: lista separada por vírgula (IPv4 e/ou IPv6)
# Exemplo: ADMIN_ALLOWED_IPS=203.0.113.10,198.51.100.22
ADMIN_ALLOWED_IPS=

# Conta dona principal (única com gestão de organizadores).
# Se vazio, padrão: dono.gabu
OWNER_USERNAME=dono.gabu

# Rotacao automatica de senha de organizador (dias).
# 0 desativa expiracao por tempo.
ORGANIZER_PIN_MAX_AGE_DAYS=90
